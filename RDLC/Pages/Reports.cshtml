@page
@model RDLC.Pages.ReportsModel
@{
    ViewData["Title"] = "Report";
}

<div class="content content-full">
    <div class="block">
        <div class="block-header border-bottom">
            <h3 class="block-title">@Model.ReportId</h3>
        </div>
        <div class="block-content">
            <div class="row">
                <div class="col-sm-12 text-center">
                    <iframe class="vh-100 w-100" title="Embedded Content" src="http://localhost:5002/ReportViewer.aspx?id=@Model.ReportId" allowfullscreen></iframe>
                </div>
            </div>
        </div>
    </div>

</div>

