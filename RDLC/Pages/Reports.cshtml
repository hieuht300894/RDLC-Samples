@page
@model RDLC.Pages.ReportsModel
@{
    ViewData["Title"] = "Report";
}

@section Scripts {
    <script src="~/js/reports.js" asp-append-version="true"></script>
}

<div class="content content-full">
    <div class="block">
        <div class="block-header border-bottom">
            <h3 class="block-title">Report</h3>
        </div>
        <div class="block-content">
            <div class="row">
                <div class="col-sm-12">
                    <div class="list-group">
                        <button type="button" class="list-group-item list-group-item-action" data-report-name="User.rdlc" onclick="selectReport(this)">User</button>
                        <button type="button" class="list-group-item list-group-item-action" data-report-name="Barcode.rdlc" onclick="selectReport(this)">Barcode</button>
                    </div>
                </div>
            </div>
        </div>
        <div class="block-content">
            <div class="row">
                <div class="col-sm-12 text-center">
                    <iframe id="ifrReport" class="vh-100 w-100" title="Embedded Content" src="http://localhost:5002/ReportViewer.aspx" allowfullscreen></iframe>
                </div>
            </div>
        </div>
    </div>
</div>

